# ==========================================
# Portfolio Environment Configuration
# ==========================================

# Base site URL for metadata and OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n Webhook Endpoint
# When set, the Next.js API route (/api/contact) forwards form submissions to this webhook.
# If left empty, submissions run in local mock/simulation mode.
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/portfolio-contact

# Secret token transmitted in the 'X-Webhook-Secret' header for authenticity verification
N8N_WEBHOOK_SECRET=secret_token_123456789_secure
